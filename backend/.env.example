# VoyageIQ Configuration Example Environment Variables
# Rename this file to '.env' and fill in your keys

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Cache Layer)
# Format: mongodb://localhost:27017/voyageiq or your Atlas URI
# Fallback: App uses in-memory mock cache if empty
MONGODB_URI=

# AI Engine Service URL
AI_ENGINE_URL=http://localhost:8000

# Google Gemini API Key (AI Chatbot)
# Get keys at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API (AI Chatbot)
# Fallback: Local rule-based simulated responder if empty
OPENAI_API_KEY=

# Flights API Keys (Aviationstack)
# Get free key at: https://aviationstack.com/signup/free
AVIATIONSTACK_KEY=

# Hotels/Trains/Destination APIs (via RapidAPI)
# Get free keys at: https://rapidapi.com/
RAPIDAPI_KEY=
BOOKING_API_KEY=
RAILWAY_API_KEY=
TRIPADVISOR_KEY=
WEATHER_API_KEY=
OPENWEATHER_KEY=
