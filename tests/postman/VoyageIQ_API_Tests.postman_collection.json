      "item": [
        {
          "name": "GET /api/search/flights — Valid Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-FL-01: Status code 200",
                  "pm.test('TC-FL-01: Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// TC-FL-02: Response is JSON array",
