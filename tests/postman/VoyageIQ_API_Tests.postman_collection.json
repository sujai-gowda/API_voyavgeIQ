    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET / — Server Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-HC-01: Status code must be 200",
                  "pm.test('TC-HC-01: Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// TC-HC-02: Response must be JSON",
                  "pm.test('TC-HC-02: Response is valid JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "// TC-HC-03: Message field must exist",
                  "pm.test('TC-HC-03: message field exists', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "});",
                  "",
                  "// TC-HC-04: Status field must be healthy",
                  "pm.test('TC-HC-04: status field is healthy', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('healthy');",
                  "});",
                  "",
                  "// TC-HC-05: Response time under 500ms",
                  "pm.test('TC-HC-05: Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/",
            "description": "Verifies the Express backend is alive and returning healthy status."
          }
        }
      ]
    },
