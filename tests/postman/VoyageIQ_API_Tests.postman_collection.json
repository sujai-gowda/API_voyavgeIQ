                { "key": "to",          "value": "{{TO}}" },
                { "key": "date",        "value": "{{DATE}}" },
                { "key": "returnDate",  "value": "{{RETURN_DATE}}" },
                { "key": "travelers",   "value": "{{TRAVELERS}}" },
                { "key": "budget",      "value": "{{BUDGET}}" }
