                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "// TC-FL-03: Array has at least one result",
                  "pm.test('TC-FL-03: At least one flight returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});",
                  "",
                  "// TC-FL-04: First item has required fields",
                  "pm.test('TC-FL-04: Flight object has required fields', function () {",
                  "    var json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        var flight = json[0];",
                  "        pm.expect(flight).to.have.property('id');",
                  "        pm.expect(flight).to.have.property('type');",
                  "        pm.expect(flight).to.have.property('carrier');",
                  "        pm.expect(flight).to.have.property('price');",
                  "        pm.expect(flight).to.have.property('departureTime');",
                  "        pm.expect(flight).to.have.property('arrivalTime');",
                  "    }",
                  "});",
                  "",
                  "// TC-FL-05: type field equals 'flight'",
                  "pm.test('TC-FL-05: type field is flight', function () {",
                  "    var json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        pm.expect(json[0].type).to.eql('flight');",
                  "    }",
                  "});",
                  "",
                  "// TC-FL-06: price is a positive number",
                  "pm.test('TC-FL-06: price is a positive number', function () {",
                  "    var json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        pm.expect(json[0].price).to.be.a('number').and.to.be.above(0);",
                  "    }",
                  "});",
                  "",
                  "// TC-FL-07: Response time under 5000ms",
                  "pm.test('TC-FL-07: Response time < 5000ms (API aggregation)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
