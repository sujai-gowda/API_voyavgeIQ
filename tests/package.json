{
  "name": "voyageiq-testing-pipeline",
  "version": "1.0.0",
  "description": "CI/CD Automated Testing Framework for VoyageIQ Travel Application",
  "main": "scripts/run-all-tests.js",
  "scripts": {
    "test": "node scripts/run-all-tests.js",
    "test:newman": "node newman/run-tests.js",
    "test:schema": "node schema-validation/validate-schemas.js",
    "test:performance": "node performance/performance-monitor.js",
    "report": "node scripts/generate-report.js",
    "dashboard": "npx serve dashboard -p 3001"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.7",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "puppeteer": "^22.15.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
