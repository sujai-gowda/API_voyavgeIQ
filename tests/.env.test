# VoyageIQ Testing Pipeline — Environment Variables
# Copy this file and adjust values for your environment

# Base URL of the running backend
BASE_URL=http://localhost:5000

# Performance thresholds (milliseconds)
PERF_PASS_THRESHOLD=500
PERF_WARN_THRESHOLD=2000

# Test data (query parameters used in API test calls)
TEST_FROM=DEL
TEST_TO=BOM
TEST_DATE=2026-08-15
TEST_RETURN_DATE=2026-08-20
TEST_TRAVELERS=2
TEST_BUDGET=50000

# Report output paths (relative to /tests)
REPORTS_DIR=./reports
LOGS_DIR=./logs

# Newman reporter settings
NEWMAN_HTML_REPORT=true
NEWMAN_JSON_REPORT=true
