{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voyageiq/train",
  "title": "Train Search Result Item",
  "description": "Schema for a single train object returned by GET /api/search/trains",
  "type": "object",
  "required": ["id", "type", "name", "price"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique train identifier"
    },
    "type": {
      "type": "string",
      "const": "train",
      "description": "Must always be 'train'"
    },
    "provider": {
      "type": "string",
      "description": "Data source (IRCTC, Mock)"
    },
    "trainNumber": {
      "type": "string",
      "description": "Train number"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Train name"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Ticket price in INR"
    },
    "departureTime": {
      "type": "string",
      "description": "ISO 8601 departure datetime"
    },
    "arrivalTime": {
      "type": "string",
      "description": "ISO 8601 arrival datetime"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Duration in minutes"
    },
    "availability": {
      "type": "string",
      "description": "Seat availability status"
    },
    "platform": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "score": {
      "type": ["number", "null"],
      "description": "AI ranking score (0-100)"
    }
  }
}
