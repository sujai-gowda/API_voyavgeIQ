{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voyageiq/budget-plan",
  "title": "Budget Plan Response",
  "description": "Schema for POST /api/ai/budget-plan response",
  "type": "object",
  "required": ["budget", "packages"],
  "additionalProperties": true,
  "properties": {
    "budget": {
      "type": "number",
      "minimum": 0,
      "description": "User's stated budget in INR"
    },
    "travelers": {
      "type": "number",
      "minimum": 1,
      "description": "Number of travelers"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "description": "List of recommended travel packages",
      "items": {
        "type": "object",
        "required": ["name", "description", "totalCost"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Package name (e.g., Smart Explorer)"
          },
          "description": {
            "type": "string"
          },
          "totalCost": {
            "type": "number",
            "minimum": 0
          },
          "nights": {
            "type": "number",
            "minimum": 0
          },
          "withinBudget": {
            "type": "boolean"
          },
          "score": {
            "type": ["number", "null"]
          }
        }
      }
    }
  }
}
